# Port the backend listens on when run as a traditional server (npm run dev / npm start).
# Not used on Vercel, which manages the port for serverless functions itself. (default: 5001)
PORT=5001

# Standard Node environment flag. Set to "production" in production deployments;
# controls things like whether stack traces are included in error responses.
NODE_ENV=development

# MongoDB connection string (local or Atlas). Required.
MONGO_URI=

# Secret used to sign JWTs. Required — the server will not start without it.
JWT_SECRET=

# OpenAI API key from https://platform.openai.com/api-keys. Required. Must be a
# key with sufficient quota/billing configured for production use.
OPENAI_API_KEY=

# Optional: override the OpenAI model used for all AI calls. Defaults to
# gpt-4o-mini if unset. Only set this for an intentional model migration.
OPENAI_MODEL=gpt-4o-mini
